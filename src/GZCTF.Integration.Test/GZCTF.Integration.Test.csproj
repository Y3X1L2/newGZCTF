<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <CollectCoverage>true</CollectCoverage>
    <ExcludeByFile>$(ExcludeByFile),**/Migrations/*.Designer.cs,**/Migrations/AppDbContextModelSnapshot.cs</ExcludeByFile>
    <Configurations>Debug;Release</Configurations>
    <ReleaseVersion>1.8.3</ReleaseVersion>
    <EnablePreviewFeatures>True</EnablePreviewFeatures>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="SimpleBase" />
    <PackageReference Include="Testcontainers.K3s" />
    <PackageReference Include="Testcontainers.Minio" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.runner.console" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="coverlet.msbuild" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures/Sftp/Dockerfile" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/Ovn/Dockerfile" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/Hybrid/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../scenarios/devices/modbus-plc/*" Link="Fixtures/Modbus/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\GZCTF\GZCTF.csproj" />
    <ProjectReference Include="..\GZCTF.Agent\GZCTF.Agent.csproj" />
    <ProjectReference Include="..\GZCTF.GuestControl.Contracts\GZCTF.GuestControl.Contracts.csproj" />
  </ItemGroup>


</Project>
