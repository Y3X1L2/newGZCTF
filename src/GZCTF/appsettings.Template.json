{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=gzctf;Username=postgres;Password=postgres",
    "RedisCache": "",
    "Storage": "disk://path=./files"
  },
  "XorKey": "gzctf-local-xor-key",

  "Agent": {
    "LocalNodeSchedulable": false
  },

  "ContainerProvider": {
    "Type": "Docker",
    "PortMappingType": "Default",
    "PublicEntry": "",
    "LocalHostAddress": "",
    "DockerConfig": {
      "PublicPortStart": 31000,
      "PublicPortEnd": 31999
    },
    "NginxProxyConfig": {
      "Enable": false,
      "SyncLocalConfig": true,
      "ConfigPath": "/etc/nginx/stream-conf.d/gzctf-stream-dynamic.conf",
      "SyncIntervalSeconds": 15,
      "NginxBinaryPath": "nginx",
      "ListenPortStart": 30000,
      "ListenPortEnd": 30999,
      "WriteStreamBlock": false,
      "SyncToken": ""
    }
  },

  "GuacamoleSettings": {
    "GuacdHost": "localhost",
    "GuacdPort": 4822,
    "GuacamoleApiUrl": "http://localhost:8081/guacamole/api",
    "GuacamoleAuthToken": "",
    "ConnectionTimeoutSeconds": 10
  },

  "KvmSettings": {
    "LibvirtUri": "qemu:///system",
    "ImageStoragePath": "/var/lib/gzctf/images",
    "DefaultVmMemoryMb": 4096,
    "DefaultVmCpu": 2,
    "OperationTimeoutSeconds": 120
  },

  "DockerRegistrySettings": {
    "Address": "10.24.0.28:5000",
    "Namespace": "ctf",
    "MaxUploadSizeGb": 10
  }
}
