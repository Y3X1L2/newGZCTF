{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::public-model-artifacts",
        "arn:aws:s3:::public-model-artifacts/*"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetBucketLocation",
        "s3:CreateBucket",
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::customer-private",
        "arn:aws:s3:::customer-private/*",
        "arn:aws:s3:::model-registry",
        "arn:aws:s3:::model-registry/*",
        "arn:aws:s3:::ci-artifacts",
        "arn:aws:s3:::ci-artifacts/*"
      ]
    }
  ]
}
